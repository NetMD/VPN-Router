<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="VpnRouter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="VPN Router">

    <Grid x:Name="RootLayout" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" SizeChanged="RootLayout_SizeChanged">
        <NavigationView
            x:Name="MainNavigation"
            PaneDisplayMode="LeftCompact"
            CompactPaneLength="76"
            OpenPaneLength="210"
            IsPaneToggleButtonVisible="False"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            SelectionChanged="MainNavigation_SelectionChanged">

            <NavigationView.PaneHeader>
                <Border
                    Width="44"
                    Height="44"
                    Margin="4,12,4,22"
                    Background="{StaticResource CoralBrush}"
                    CornerRadius="11">
                    <TextBlock
                        Text="VR"
                        Foreground="White"
                        FontSize="15"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="홈" Tag="home" IsSelected="True" ToolTipService.ToolTip="홈">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="VPN 프로필" Tag="profiles" ToolTipService.ToolTip="VPN 프로필">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Contact" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="VPN 사이트" Tag="sites" ToolTipService.ToolTip="VPN으로 열 사이트">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="World" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="문제 해결" Tag="diagnostics" ToolTipService.ToolTip="문제 해결">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Repair" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="설정" Tag="settings" ToolTipService.ToolTip="설정">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.Content>
                <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                    <Grid x:Name="HomePanel">
                        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel MaxWidth="1120" HorizontalAlignment="Stretch" Padding="36,28,36,36" Spacing="22">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="VPN Router" Style="{StaticResource PageTitleStyle}" />
                                    <TextBlock Text="선택한 사이트만 VPN으로 연결합니다." Style="{StaticResource CaptionStyle}" />
                                </StackPanel>

                                <Border Style="{StaticResource CardStyle}" Padding="28">
                                    <Grid x:Name="ConnectionSummaryGrid" ColumnSpacing="28" RowSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Spacing="12" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <SymbolIcon Symbol="Contact" Foreground="{StaticResource CoralBrush}" />
                                                <TextBlock Text="이 PC → 선택 사이트 → VPN" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="16" />
                                            </StackPanel>
                                            <TextBlock
                                                x:Name="ConnectionStateText"
                                                Text="연결 안 됨"
                                                FontSize="36"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                x:Name="ConnectionDetailsText"
                                                Text="연결하면 선택한 사이트만 VPN을 사용합니다."
                                                Style="{StaticResource CaptionStyle}"
                                                FontSize="16" />
                                        </StackPanel>

                                        <StackPanel x:Name="ConnectionActionPanel" Grid.Column="1" Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                            <Button
                                                x:Name="ConnectButton"
                                                Content="연결"
                                                Style="{StaticResource CoralButtonStyle}"
                                                HorizontalAlignment="Stretch"
                                                Click="ConnectButton_Click"
                                                AutomationProperties.Name="VPN 연결 또는 연결 해제" />
                                            <Button
                                                x:Name="ValidateConnectionPlanButton"
                                                Content="연결 준비 확인"
                                                Style="{StaticResource OutlineButtonStyle}"
                                                HorizontalAlignment="Stretch"
                                                Click="ValidateConnectionPlanButton_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid x:Name="HomeSummaryGrid" ColumnSpacing="16" RowSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border x:Name="HomeProfileCard" Style="{StaticResource CardStyle}" MinHeight="150">
                                        <StackPanel Spacing="10">
                                            <Border Width="42" Height="42" HorizontalAlignment="Left" Background="{StaticResource CoralSoftBrush}" CornerRadius="12">
                                                <SymbolIcon Symbol="ProtectedDocument" Foreground="{StaticResource CoralBrush}" />
                                            </Border>
                                            <TextBlock Text="선택한 VPN 프로필" FontWeight="SemiBold" />
                                            <TextBlock x:Name="ProfileDetailsText" Text="WireGuard 프로필을 선택하세요." Style="{StaticResource CaptionStyle}" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="HomeRecentStatusCard" Grid.Column="1" Style="{StaticResource CardStyle}" MinHeight="150">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="최근 상태" Style="{StaticResource SectionTitleStyle}" />
                                            <ItemsControl x:Name="RecentStatusList">
                                                <TextBlock Text="연결 기록이 여기에 표시됩니다." Style="{StaticResource CaptionStyle}" />
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="ProfilesPanel" Visibility="Collapsed">
                        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel MaxWidth="1120" HorizontalAlignment="Stretch" Padding="36,28,36,36" Spacing="22">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="VPN 프로필" Style="{StaticResource PageTitleStyle}" />
                                    <TextBlock Text="VPN 제공업체에서 받은 WireGuard 설정을 관리합니다." Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                                <Grid x:Name="ProfilesCardsGrid" ColumnSpacing="16" RowSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border x:Name="ProfilesImportCard" Style="{StaticResource CardStyle}" Padding="28">
                                        <StackPanel Spacing="16">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="프로필 가져오기" Style="{StaticResource SectionTitleStyle}" />
                                                <TextBlock Text="VPN 제공업체에서 받은 WireGuard 설정 파일을 선택하세요." Style="{StaticResource CaptionStyle}" />
                                            </StackPanel>
                                            <Button Style="{StaticResource CoralButtonStyle}" Click="ImportWireGuardButton_Click" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <SymbolIcon Symbol="Import" />
                                                    <TextBlock Text="프로필 가져오기" />
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Text="설정 원문과 개인 키는 화면에 표시하지 않습니다." Style="{StaticResource CaptionStyle}" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="ProfilesSavedCard" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="28">
                                        <StackPanel Spacing="16">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="저장된 프로필" Style="{StaticResource SectionTitleStyle}" />
                                                <TextBlock Text="연결에 사용할 프로필을 선택하고 이름을 관리하세요." Style="{StaticResource CaptionStyle}" />
                                            </StackPanel>
                                            <ComboBox
                                                x:Name="ProfileComboBox"
                                                SelectedIndex="0"
                                                HorizontalAlignment="Stretch"
                                                SelectionChanged="ProfileComboBox_SelectionChanged" />
                                            <Rectangle Height="1" Fill="{ThemeResource ControlStrokeColorDefaultBrush}" Margin="0,2" />
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="ProfileNameTextBox" PlaceholderText="프로필 이름" />
                                                <Button Grid.Column="1" Content="이름 변경" Click="RenameProfileButton_Click" />
                                                <Button Grid.Column="2" Click="DeleteProfileButton_Click" ToolTipService.ToolTip="프로필 삭제" AutomationProperties.Name="프로필 삭제">
                                                    <SymbolIcon Symbol="Delete" />
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Style="{StaticResource CardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="WireGuard for Windows" FontWeight="SemiBold" />
                                            <TextBlock x:Name="WireGuardInstallStatusText" Text="WireGuard 설치 상태를 확인하는 중입니다." Style="{StaticResource CaptionStyle}" />
                                        </StackPanel>
                                        <Button x:Name="InstallWireGuardButton" Grid.Column="1" Content="설치 안내" Click="InstallWireGuardButton_Click" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Padding="28">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="이전 실행 캐시 정리" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Text="현재 및 직전 버전은 유지하며, 가져온 프로필과 보안 키는 삭제하지 않습니다." Style="{StaticResource CaptionStyle}" MaxWidth="580" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Content="캐시 정리"
                                            Click="CleanupPortableCacheButton_Click"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="SitesPanel" Visibility="Collapsed">
                        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel MaxWidth="1120" HorizontalAlignment="Stretch" Padding="36,28,36,36" Spacing="22">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="VPN으로 열 사이트" Style="{StaticResource PageTitleStyle}" />
                                    <TextBlock Text="등록한 사이트와 필요한 하위 도메인만 VPN 경로를 사용합니다." Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                                <Border Style="{StaticResource CardStyle}" Padding="28">
                                    <StackPanel Spacing="18">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="DomainTextBox" PlaceholderText="example.com" VerticalContentAlignment="Center" />
                                            <Button Grid.Column="1" Style="{StaticResource CoralButtonStyle}" Click="AddDomainButton_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <SymbolIcon Symbol="Add" />
                                                    <TextBlock Text="사이트 추가" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <ListView x:Name="DomainRulesList" MinHeight="300" MaxHeight="470" SelectionMode="None" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="DiagnosticsPanel" Visibility="Collapsed">
                        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel MaxWidth="1120" HorizontalAlignment="Stretch" Padding="36,28,36,36" Spacing="22">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="문제 해결" Style="{StaticResource PageTitleStyle}" />
                                    <TextBlock Text="연결 상태를 확인하고 네트워크 설정을 안전하게 복구합니다." Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                                <Border Style="{StaticResource CardStyle}" Padding="28">
                                    <StackPanel Spacing="16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="진단 정보" Style="{StaticResource SectionTitleStyle}" />
                                            <Button Grid.Column="1" Click="RefreshDiagnosticsButton_Click" ToolTipService.ToolTip="진단 새로고침">
                                                <SymbolIcon Symbol="Refresh" />
                                            </Button>
                                        </Grid>
                                        <ItemsControl x:Name="DiagnosticsList" />
                                        <TextBlock x:Name="FeatureFlagsText" Text="서비스 상태를 확인하는 중입니다." Style="{StaticResource CaptionStyle}" />
                                        <Button Content="문제 해결 파일 만들기" Click="CreateTroubleshootingFileButton_Click" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" BorderBrush="#FFFFD7D9">
                                    <Grid ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="네트워크 설정 복구" FontSize="17" FontWeight="SemiBold" />
                                            <TextBlock Text="DNS 또는 VPN 경로가 정상으로 돌아오지 않았을 때 사용하세요." Style="{StaticResource CaptionStyle}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="복구 실행" Style="{StaticResource OutlineButtonStyle}" Click="RestoreNetworkButton_Click" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel MaxWidth="1120" HorizontalAlignment="Stretch" Padding="36,28,36,36" Spacing="22">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="설정" Style="{StaticResource PageTitleStyle}" />
                                    <TextBlock Text="VPN Router의 필수 연결 보호 동작을 확인합니다." Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                                <Border Style="{StaticResource CardStyle}" Padding="28">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="필수 연결 보호" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock
                                            Text="DNS 응답 경로, VPN 구성 또는 관리 중인 경로를 안전하게 유지할 수 없으면 VPN Router가 소유한 연결과 네트워크 상태만 자동으로 정리합니다. 다른 VPN이나 보안 제품은 변경하지 않습니다."
                                            Style="{StaticResource CaptionStyle}"
                                            MaxWidth="650" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
